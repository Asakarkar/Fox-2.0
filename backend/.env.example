PORT=8000
NODE_ENV=development

# Local MongoDB must run as a single-node replica set for account transactions.
MONGO_URI=mongodb://127.0.0.1:27018/fox?replicaSet=rs0

JWT_SECRET=replace-with-a-random-local-secret
JWT_EXPIRES_IN="1d"

SESSION_SECRET=replace-with-a-random-local-secret
SESSION_EXPIRES_IN="1d"

# Replace these placeholders with Google OAuth credentials to enable Google login.
GOOGLE_CLIENT_ID=local-development-placeholder
GOOGLE_CLIENT_SECRET=local-development-placeholder
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_GOOGLE_CALLBACK_URL=http://localhost:5173/google/callback